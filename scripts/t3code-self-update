#!/usr/bin/env bash
# Run by the T3 server (t3code-run sets it as T3CODE_SELF_UPDATE_COMMAND).
# <prefix>-self-update --latest prints the version Forgejo's tag points at.
# <prefix>-self-update VERSION checks that Forgejo has the exact version, then
# installs it from a transient unit: the install restarts the service this was
# started from.
set -euo pipefail
name=$(basename -- "$0")
prefix=${name%-self-update}
version=${1:?Usage: $name --latest | VERSION}
update="$HOME/.local/bin/$prefix-update"
if [[ $version == --latest ]]; then
  "$update" --check 2>/dev/null | sed -n 's/^t3@\([^ ]*\) .*/\1/p' | tail -n 1
  exit
fi
if ! "$update" --check "$version" >/dev/null 2>&1; then
  echo "t3@$version was not found on Forgejo." >&2
  exit 1
fi
exec systemd-run --user --collect --quiet --unit="$prefix-self-update-$(date +%s)" \
  --setenv=PATH="$PATH" \
  ${PACKAGE_FOGEJO_TOKEN_FILE:+--setenv=PACKAGE_FOGEJO_TOKEN_FILE="$PACKAGE_FOGEJO_TOKEN_FILE"} \
  "$update" --yes "$version"
