#!/usr/bin/env bash
# Runs one T3 instance's server; installed as <prefix>-run (t3code-run,
# t3code-NAME-run), whose name selects ~/.config/<prefix>/service.env.
set -euo pipefail
name=$(basename -- "$0")
source "${HOME}/.config/${name%-run}/service.env"
export PATH="$(dirname "$T3CODE_NODE"):${HOME}/.local/bin:${HOME}/.volta/bin:/usr/local/bin:/usr/bin:/bin"
exec "$T3CODE_NODE" "$T3CODE_ENTRY" serve --host "$T3CODE_HOST" \
  --port "$T3CODE_PORT" --base-dir "$T3CODE_BASE" "$T3CODE_WORKDIR"
